#!/usr/bin/env bash
# Generated by scripts/release.sh from scripts/launcher.sh.in. The Pickglass
# launcher.
set -euo pipefail
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
root=$(dirname "$here")

# Distribution is a property of the VM's boot, so the standard Erlang options
# that choose its transport are taken out of the arguments here and given to
# the emulator before Gleam code runs. `--proto-dist inet_tls
# --ssl-dist-optfile FILE` attaches to a node that runs TLS distribution, and
# the file is the stock `ssl_dist_optfile` any Erlang node can use.
# `--name NAME@HOST` fixes the viewer's own node name, which the program
# otherwise picks at random for each attach. A target that lists the nodes it
# accepts by name drops any other, so it needs the listed one. A named viewer
# is still hidden and still opens no listening port. Nothing else changes: the
# cookie is still read from a file and set per peer. An operator who prefers
# the environment can set ERL_FLAGS, which the emulator reads itself.
#
# `--attach-dir DIR` (or PICKGLASS_ATTACH_DIR, with the flag winning) names a
# directory that holds everything a TLS attach needs: `ssl_dist.conf` (the
# optfile), `.erlang.cookie` (the target's cookie) and `node` (one line, the
# viewer's own node name). It supplies defaults for the three options above and
# for `--cookie-file`, so any of them given explicitly wins over the directory.
#
# `--attach NAME` names a child of the attach root, `$PICKGLASS_ATTACH_HOME` or
# else `$HOME/.pickglass/attach`, and is the same as `--attach-dir ROOT/NAME`.
# Nothing reads the root unless `--attach` is given, so a plain attach never
# depends on it, and the root is never created.
proto=""
optfile=""
name=""
cookie_given=""
attach_dir="${PICKGLASS_ATTACH_DIR:-}"
attach_name=""
attach_given=""
passed=()
while (( $# > 0 )); do
  case "$1" in
    --)
      # Everything after a bare `--` belongs to the program.
      passed+=("$@")
      break
      ;;
    --attach)
      (( $# >= 2 )) || { echo "pickglass: $1 needs a value" >&2; exit 2; }
      attach_name=$2
      attach_given=1
      shift 2
      ;;
    --attach=*)
      attach_name=${1#*=}
      attach_given=1
      shift
      ;;
    --proto-dist | --ssl-dist-optfile | --name | --attach-dir)
      (( $# >= 2 )) || { echo "pickglass: $1 needs a value" >&2; exit 2; }
      case "$1" in
        --proto-dist) proto=$2 ;;
        --name) name=$2 ;;
        --attach-dir) attach_dir=$2 ;;
        *) optfile=$2 ;;
      esac
      shift 2
      ;;
    --proto-dist=* | --ssl-dist-optfile=* | --name=* | --attach-dir=*)
      case "$1" in
        --proto-dist=*) proto=${1#*=} ;;
        --name=*) name=${1#*=} ;;
        --attach-dir=*) attach_dir=${1#*=} ;;
        *) optfile=${1#*=} ;;
      esac
      shift
      ;;
    --cookie-file | --cookie-file=*)
      # The program still parses this; the launcher only needs to know that
      # the directory's cookie must not be offered as a default.
      cookie_given=1
      passed+=("$1")
      shift
      ;;
    *)
      passed+=("$1")
      shift
      ;;
  esac
done

# `--attach NAME` is the only thing that reads the attach root, and only when
# no explicit flag or variable has chosen the transport. A name is checked even
# when it is then unused, so a typo or a path escape is never silently ignored.
if [[ -n "$attach_given" ]]; then
  [[ "$attach_name" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] \
    || { echo "pickglass: invalid attach name $attach_name" >&2; exit 2; }
  if [[ -z "$attach_dir$proto$optfile$name" ]]; then
    attach_root="${PICKGLASS_ATTACH_HOME:-${HOME:-}/.pickglass/attach}"
    if [[ ! -d "$attach_root/$attach_name" ]]; then
      avail=""
      for d in "$attach_root"/[!.]*/; do
        if [[ -d "$d" ]]; then avail+=" $(basename "$d")"; fi
      done
      echo "pickglass: no attach directory named $attach_name in $attach_root (available:${avail:- none})" >&2
      exit 2
    fi
    attach_dir="$attach_root/$attach_name"
  fi
fi

# The directory is checked before the emulator starts. An error names a path
# and never prints a file's contents, because the directory also holds the
# cookie; only the node name is ever read.
if [[ -n "$attach_dir" ]]; then
  [[ -d "$attach_dir" ]] \
    || { echo "pickglass: attach directory $attach_dir does not exist" >&2; exit 2; }
  if [[ -z "$optfile" ]]; then
    [[ -s "$attach_dir/ssl_dist.conf" ]] \
      || { echo "pickglass: $attach_dir/ssl_dist.conf is missing or empty" >&2; exit 2; }
    optfile="$attach_dir/ssl_dist.conf"
  fi
  if [[ -z "$name" ]]; then
    [[ -s "$attach_dir/node" ]] \
      || { echo "pickglass: $attach_dir/node is missing or empty" >&2; exit 2; }
    [[ $(grep -c '' "$attach_dir/node") -eq 1 ]] \
      || { echo "pickglass: $attach_dir/node must hold exactly one line" >&2; exit 2; }
    name=$(<"$attach_dir/node")
    [[ -n "${name//[[:space:]]/}" ]] \
      || { echo "pickglass: $attach_dir/node is empty" >&2; exit 2; }
  fi
  proto=${proto:-inet_tls}

  # The cookie default goes in front of the program's arguments, where the
  # Gleam parser reads `--cookie-file` like any other.
  if [[ -z "$cookie_given" ]]; then
    passed=(--cookie-file "$attach_dir/.erlang.cookie" ${passed[@]+"${passed[@]}"})
  fi
fi

dist_flags=()
[[ -z "$proto" ]] || dist_flags+=(-proto_dist "$proto")
[[ -z "$optfile" ]] || dist_flags+=(-ssl_dist_optfile "$optfile")
[[ -z "$name" ]] || dist_flags+=(-name "$name" -hidden -dist_listen false)

# `-nocookie` gives the viewer's VM no distribution cookie of its own. Without
# it, starting distribution makes OTP's `auth` create ~/.erlang.cookie in the
# operator's home. The viewer does not listen, so nothing connects to it, and
# the only cookie it uses is the target's, set per peer after it is read from
# the target's owner-only file.
exec "$root/erts-@ERTS_VSN@/bin/erl" +Bd \
  -nocookie \
  ${dist_flags[@]+"${dist_flags[@]}"} \
  -boot "$root/bin/no_dot_erlang" \
  -pa "$root"/lib/*/ebin \
  -noshell \
  -eval 'pickglass@@main:run(pickglass)' \
  -extra ${passed[@]+"${passed[@]}"}
