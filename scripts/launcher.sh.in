#!/usr/bin/env bash
# Generated by scripts/release.sh from scripts/launcher.sh.in. The Pickglass
# launcher.
set -euo pipefail
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
root=$(dirname "$here")

# Distribution is a property of the VM's boot, so the standard Erlang options
# that choose its transport are taken out of the arguments here and given to
# the emulator before Gleam code runs. `--proto-dist inet_tls
# --ssl-dist-optfile FILE` attaches to a node that runs TLS distribution, and
# the file is the stock `ssl_dist_optfile` any Erlang node can use.
# `--name NAME@HOST` fixes the viewer's own node name, which the program
# otherwise picks at random for each attach. A target that lists the nodes it
# accepts by name drops any other, so it needs the listed one. A named viewer
# is still hidden and still opens no listening port. Nothing else changes: the
# cookie is still read from a file and set per peer. An operator who prefers
# the environment can set ERL_FLAGS, which the emulator reads itself.
dist_flags=()
passed=()
while (( $# > 0 )); do
  case "$1" in
    --)
      # Everything after a bare `--` belongs to the program.
      passed+=("$@")
      break
      ;;
    --proto-dist | --ssl-dist-optfile | --name)
      (( $# >= 2 )) || { echo "pickglass: $1 needs a value" >&2; exit 2; }
      case "$1" in
        --proto-dist) dist_flags+=(-proto_dist "$2") ;;
        --name) dist_flags+=(-name "$2" -hidden -dist_listen false) ;;
        *) dist_flags+=(-ssl_dist_optfile "$2") ;;
      esac
      shift 2
      ;;
    --proto-dist=* | --ssl-dist-optfile=* | --name=*)
      case "$1" in
        --proto-dist=*) dist_flags+=(-proto_dist "${1#*=}") ;;
        --name=*) dist_flags+=(-name "${1#*=}" -hidden -dist_listen false) ;;
        *) dist_flags+=(-ssl_dist_optfile "${1#*=}") ;;
      esac
      shift
      ;;
    *)
      passed+=("$1")
      shift
      ;;
  esac
done

# `-nocookie` gives the viewer's VM no distribution cookie of its own. Without
# it, starting distribution makes OTP's `auth` create ~/.erlang.cookie in the
# operator's home. The viewer does not listen, so nothing connects to it, and
# the only cookie it uses is the target's, set per peer after it is read from
# the target's owner-only file.
exec "$root/erts-@ERTS_VSN@/bin/erl" +Bd \
  -nocookie \
  ${dist_flags[@]+"${dist_flags[@]}"} \
  -boot "$root/bin/no_dot_erlang" \
  -pa "$root"/lib/*/ebin \
  -noshell \
  -eval 'pickglass@@main:run(pickglass)' \
  -extra ${passed[@]+"${passed[@]}"}
